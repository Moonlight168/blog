# Web 服务（默认仅本机访问）
INTERVIEW_HOST=127.0.0.1
INTERVIEW_PORT=8890
# 简历目录，可留空：留空时默认用 <博客仓库>/src/private/resume
# 也可在页面上直接改，「保存并刷新」会写回这一行
INTERVIEW_RESUME_DIR=

# 简历所属人的目录名（简历目录下的一级子目录，如 `zhangsan`）。
# 自我介绍就挂在这个目录下：<简历目录>/<人目录>/自我介绍/。
# **一般不用配**：留空会自动识别——哪个人目录下已经有「自我介绍」就用哪个，
# 都没有就取第一个人目录（按名字排序）。只有简历目录还空着时才用占位名 `me`。
# 一台机器上有多个人、想强制指定时，才需要填这一行。
INTERVIEW_PERSON_DIR=

# VuePress 文档站地址，用于打开题目的「回答历史」链接（默认 http://127.0.0.1:8888）
# 端口要与 src/.vuepress/config.ts 里的 port 一致
INTERVIEW_DOCS_BASE_URL=

# OpenAI 兼容的对话模型（默认这家；换别家只改这三行）
INTERVIEW_CHAT_BASE_URL=https://api.deepseek.com/v1
INTERVIEW_CHAT_API_KEY=
INTERVIEW_CHAT_MODEL=deepseek-flash

# OpenAI 兼容的 Embedding 模型；不配置时自动退化为精确匹配 + FTS5
INTERVIEW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
INTERVIEW_EMBEDDING_API_KEY=
INTERVIEW_EMBEDDING_MODEL=BAAI/bge-m3
